/android/build/

# ── Signing material (defense in depth; android/.gitignore covers these too) ─
# key.properties.example is a template and IS meant to be committed.
android/key.properties
*.keystore
*.jks
local.properties

# ── Large artifacts: never committed (GitHub blocks any file over 100 MB) ────
# The dataset archive and Keras weights live outside the repo; the app only
# needs the two converted .tflite files under assets/models/.
deepfake_images_and_videos.zip
deepfake_images_and_videos/
_w8.zip
*.zip
*.apk
*.aab
assets/models/*.keras

# ── Tool / editor state, regenerable and not part of the source ──────────────
.qoder/
.kilo/
.ide/
.kiro/
.dist/
__pycache__/
